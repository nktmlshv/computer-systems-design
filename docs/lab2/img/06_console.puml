@startuml
title console_update() и process_char()
start
while (uart_receive_byte(&c)?) is (есть байт)
  if (c == LF и предыдущий был CR?) then (да)
    :previous_was_cr = false;
  else (нет)
    :previous_was_cr = (c == CR);
    if (c == CR или LF?) then (да)
      :Отправить "\r\n";
      :execute_line();
      :line_length = 0;
    elseif (c == Backspace или Delete?) then (да)
      if (line_length > 0?) then (да)
        :line_length--;
        :Отправить "\b \b";
      endif
    elseif (печатный символ и строка не переполнена?) then (да)
      :line[line_length++] = c;
      :Отправить эхо символа;
    endif
  endif
endwhile (очередь пуста)
stop
@enduml
